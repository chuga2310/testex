# testex configuration — copy to .env and adjust

# Where LanceDB stores the index (relative to project root)
TESTEX_DB_PATH=.testex/db

# ONNX embedding model (stored in ./models/ after npm install)
TESTEX_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Vector dimension (must match model)
TESTEX_EMBEDDING_DIM=384

# File extensions to scan
TESTEX_INDEX_EXTENSIONS=[".tsx",".jsx",".ts",".js"]

# Directories to skip
TESTEX_EXCLUDE_DIRS=["node_modules",".git","dist","build",".next","coverage"]

# HTML attributes treated as test IDs
TESTEX_DATA_TEST_ATTRS=["data-test","data-testid","data-cy","data-e2e"]

# Search results returned by default
TESTEX_SEARCH_LIMIT=10

# REST API
TESTEX_API_HOST=0.0.0.0
TESTEX_API_PORT=8000

# Optional: custom models directory (default: ./models)
# TESTEX_MODELS_DIR=/path/to/models
